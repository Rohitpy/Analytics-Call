# ============================================================================
# Theme Analytics - environment configuration
# Copy to `.env` and edit. Every value below is optional; defaults are shown.
# ============================================================================

# ---- app -------------------------------------------------------------------
APP_NAME=Theme Analytics
ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=*

# ---- storage ---------------------------------------------------------------
# Root for uploads / intermediate artefacts / excel exports / log files.
# Relative paths resolve against the working directory, so prefer an absolute
# path if you start the service from anywhere other than the repo root.
STORAGE_DIR=./storage

# ---- upload limits ---------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_FILES_PER_JOB=200
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.flac,.aac,.wma,.amr,.opus,.webm,.mp4

# ---- ffmpeg ----------------------------------------------------------------
FFMPEG_PATH=/opt/genaiadm/call_quality/ffmpeg/ffmpeg

# ---- speech to text --------------------------------------------------------
# STT_BACKEND: "whisper" (real, needs GPU) | "mock" (dev without a GPU)
STT_BACKEND=whisper
WHISPER_MODEL_PATH=/data0/genaiadm_bkp/GenAi-LLM/whisper/large-v3.pt
WHISPER_DEVICE=cuda:0
WHISPER_LANGUAGE=ar
WHISPER_INITIAL_PROMPT=
# How many audio files may sit on the GPU at once. 1 is right for a single card.
STT_CONCURRENCY=1
# Load the Whisper weights at startup instead of on the first request.
STT_WARMUP=true
CHUNK_DURATION=30
SILENCE_PAD=0.3
TARGET_SAMPLE_RATE=16000

# ---- LLM (vLLM / any OpenAI-compatible server) ------------------------------
LLM_BASE_URL=http://localhost:8003/v1
LLM_API_KEY=EMPTY
# Leave empty to auto-discover the first model the server advertises.
LLM_MODEL=gemma-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=7000
LLM_TIMEOUT=600
LLM_MAX_RETRIES=3
# Concurrent in-flight LLM requests across the whole process.
LLM_MAX_CONCURRENCY=8
# vLLM-only structured decoding. Turn off for servers without guided_json.
LLM_USE_GUIDED_JSON=true

# ---- pipeline --------------------------------------------------------------
# Calls processed in parallel. STT_CONCURRENCY still gates the GPU stage.
PIPELINE_WORKERS=4
# Keep the per-call PCM/JSON/TXT artefacts after a job finishes.
KEEP_INTERMEDIATE_FILES=true
# Skip the translation stage when the transcript already looks like English.
AUTO_DETECT_LANGUAGE=true
JOB_RETENTION_DAYS=30
